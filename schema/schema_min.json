{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SchemaMinLabel",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dataset",
    "episode_id",
    "frame_id",
    "target_object",
    "phase",
    "state",
    "affordance_mask"
  ],
  "properties": {
    "dataset": {
      "type": "string",
      "enum": ["libero", "handover_sim", "genh2r", "unknown"]
    },
    "episode_id": {
      "type": "string",
      "minLength": 1
    },
    "frame_id": {
      "type": "integer",
      "minimum": 0
    },
    "target_object": {
      "type": "string",
      "minLength": 1
    },
    "phase": {
      "type": "string",
      "enum": [
        "reach",
        "grasp",
        "manipulate",
        "place",
        "done",
        "align",
        "contact",
        "transfer",
        "secure",
        "retract",
        "failure",
        "UNK"
      ]
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contact_confirmed", "object_secured", "occluded"],
      "properties": {
        "contact_confirmed": {
          "type": "string",
          "enum": ["T", "F", "UNK"]
        },
        "object_secured": {
          "type": "string",
          "enum": ["T", "F", "UNK"]
        },
        "occluded": {
          "type": "string",
          "enum": ["T", "F", "UNK"]
        }
      }
    },
    "affordance_mask": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "HOLD",
        "BACKOFF_SMALL",
        "VIEWPOINT_CHANGE",
        "REALIGN",
        "CLOSE_GENTLE",
        "RETRACT",
        "PROMPT"
      ],
      "properties": {
        "HOLD": { "type": "integer", "enum": [0, 1] },
        "BACKOFF_SMALL": { "type": "integer", "enum": [0, 1] },
        "VIEWPOINT_CHANGE": { "type": "integer", "enum": [0, 1] },
        "REALIGN": { "type": "integer", "enum": [0, 1] },
        "CLOSE_GENTLE": { "type": "integer", "enum": [0, 1] },
        "RETRACT": { "type": "integer", "enum": [0, 1] },
        "PROMPT": { "type": "integer", "enum": [0, 1] }
      }
    }
  }
}
