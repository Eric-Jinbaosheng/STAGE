{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://h2r.local/interaction_schema.json",
  "title": "H2R Interaction Schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "meta",
    "phase",
    "state",
    "constraints",
    "affordances",
    "next_action"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["episode_id", "t", "dt"],
      "properties": {
        "episode_id": { "type": "string", "minLength": 1 },
        "t": { "type": "number" },
        "dt": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "phase": {
      "type": "string",
      "enum": ["offer", "reach", "align", "contact", "transfer", "secure", "retract", "failure"]
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contact_confirmed", "human_released", "object_secured", "occluded"],
      "properties": {
        "contact_confirmed": { "$ref": "#/$defs/triState" },
        "human_released": { "$ref": "#/$defs/triState" },
        "object_secured": { "$ref": "#/$defs/triState" },
        "occluded": { "$ref": "#/$defs/triState" }
      }
    },
    "constraints": {
      "type": "array",
      "items": { "type": "string" }
    },
    "affordances": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "params", "preconditions", "expected_observation", "score"],
        "properties": {
          "name": { "$ref": "#/$defs/actionName" },
          "params": { "type": "object" },
          "preconditions": {
            "type": "array",
            "items": { "type": "string" }
          },
          "expected_observation": { "type": "string" },
          "score": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "next_action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chosen", "reason"],
      "properties": {
        "chosen": { "$ref": "#/$defs/actionName" },
        "reason": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "triState": {
      "anyOf": [
        { "type": "boolean" },
        { "type": "string", "const": "unknown" }
      ]
    },
    "actionName": {
      "type": "string",
      "enum": [
        "HOLD_COMPLIANT",
        "BACKOFF_SMALL",
        "VIEWPOINT_CHANGE",
        "REALIGN",
        "CLOSE_GENTLE",
        "PROMPT_HUMAN_RELEASE"
      ]
    }
  }
}
